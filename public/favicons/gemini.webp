<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>404 · 页面未找到 · Net.Coffee</title>
<meta name="robots" content="noindex,follow">
<meta http-equiv="refresh" content="3;url=/">
<link rel="icon" href="/favicon.ico">
<script>(function(){var t=localStorage.getItem('theme');if(t==='light'||t==='dark')document.documentElement.setAttribute('data-theme',t);})();</script>
<style>
 *{box-sizing:border-box;margin:0;padding:0}
 :root{--bg:#fff;--text:#1a1a1a;--text-soft:#57606a;--text-muted:#8b949e;--border:#e1e4e8;--accent:#6366f1}
 [data-theme="dark"]{--bg:#0d1117;--text:#e6edf3;--text-soft:#c9d1d9;--text-muted:#8b949e;--border:#30363d;--accent:#818cf8}
 @media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0d1117;--text:#e6edf3;--text-soft:#c9d1d9;--text-muted:#8b949e;--border:#30363d;--accent:#818cf8}}
 html,body{height:100%}
 body{background:var(--bg);color:var(--text);font-family:system-ui,-apple-system,"Segoe UI","PingFang SC","Microsoft YaHei",sans-serif;
   display:flex;align-items:center;justify-content:center;min-height:100vh;padding:24px;overflow:hidden}
 body::before{content:"";position:fixed;inset:0;pointer-events:none;
   background:radial-gradient(circle at 50% 40%,rgba(99,102,241,.10),transparent 62%)}
 .wrap{position:relative;text-align:center;animation:rise .6s cubic-bezier(.2,.7,.2,1) both}
 @keyframes rise{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
 .four04{display:flex;align-items:center;justify-content:center;gap:clamp(8px,2.6vw,22px);line-height:1;
   font-weight:800;font-size:clamp(88px,23vw,172px);letter-spacing:-3px}
 .four04 .d{background:linear-gradient(135deg,#0ea5e9,#6366f1 48%,#a855f7);-webkit-background-clip:text;background-clip:text;
   color:transparent;animation:float 3.4s ease-in-out infinite}
 .four04 .d:last-child{animation-delay:.3s}
 @keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-9px)}}
 /* 中间的「0」= 一枚丢失的 Ping 信号（雷达波扩散消散） */
 .ping{position:relative;width:clamp(60px,15.5vw,120px);height:clamp(60px,15.5vw,120px);
   display:inline-flex;align-items:center;justify-content:center;flex:none}
 .ping b{width:13%;height:13%;border-radius:50%;background:var(--accent);box-shadow:0 0 18px 2px var(--accent)}
 .ping i{position:absolute;inset:0;border:2.5px solid var(--accent);border-radius:50%;opacity:0;animation:pingr 2.4s cubic-bezier(.2,.6,.3,1) infinite}
 .ping i:nth-child(2){animation-delay:1.2s}
 @keyframes pingr{0%{transform:scale(.18);opacity:.9}70%{opacity:.12}100%{transform:scale(1);opacity:0}}
 h1{margin-top:clamp(16px,3.4vw,28px);font-size:clamp(19px,4.6vw,25px);font-weight:700;letter-spacing:.3px}
 .sub{margin-top:9px;color:var(--text-soft);font-size:clamp(13px,3.4vw,15px)}
 .sub code{font-family:ui-monospace,Consolas,monospace}
 .bar{margin:24px auto 0;width:min(240px,72vw);height:4px;border-radius:99px;background:var(--border);overflow:hidden}
 .bar i{display:block;height:100%;width:100%;border-radius:99px;background:linear-gradient(90deg,#0ea5e9,#6366f1,#a855f7);
   transform-origin:left;animation:drain 3s linear forwards}
 @keyframes drain{from{transform:scaleX(1)}to{transform:scaleX(0)}}
 .cd{margin-top:15px;color:var(--text-muted);font-size:14px}
 .cd b{color:var(--text);font-variant-numeric:tabular-nums}
 .cd a{color:var(--accent);text-decoration:none;font-weight:600}
 .cd a:hover{text-decoration:underline}
 @media (prefers-reduced-motion:reduce){*{animation:none!important}.bar i{transform:scaleX(0)}}
</style>
</head>
<body>
 <main class="wrap">
  <div class="four04" role="img" aria-label="404 页面未找到">
    <span class="d" aria-hidden="true">4</span>
    <span class="ping" aria-hidden="true"><i></i><i></i><b></b></span>
    <span class="d" aria-hidden="true">4</span>
  </div>
  <h1>无法路由到该页面</h1>
  <p class="sub">Destination unreachable — 这个地址不存在，或已经迁移</p>
  <div class="bar" aria-hidden="true"><i></i></div>
  <p class="cd"><b id="cd">3</b> 秒后自动返回首页 · <a href="/">立即返回 →</a></p>
 </main>
 <script>
  (function(){var n=3,el=document.getElementById('cd');
   var t=setInterval(function(){n--;
     if(n<=0){clearInterval(t);try{location.replace('/');}catch(e){location.href='/';}}
     else{el.textContent=n;}},1000);})();
 </script>
</body>
</html>
