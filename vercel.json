{
  "version": 2,
  "routes": [
    {
      "src": "/cdn-cgi/trace",
      "dest": "/api/trace.js"
    },
    {
      "src": "/api/myip",
      "dest": "/api/myip.js"
    },
    {
      "src": "/api/geoip/(.*)",
      "dest": "/api/geoip.js?ip=$1"
    },
    {
      "src": "/api/geoip-batch",
      "dest": "/api/geoip-batch.js"
    },
    {
      "src": "/api/ipscore/(.*)",
      "dest": "/api/ipscore.js?ip=$1"
    },
    {
      "src": "/api/iprisk/(.*)",
      "dest": "/api/iprisk.js?ip=$1"
    },
    {
      "src": "/api/dns/result/(.*)",
      "dest": "/api/dns-result.js?token=$1"
    },
    {
      "src": "/api/ip/lookup/(.*)",
      "dest": "/api/ip-lookup.js?ip=$1"
    },
    {
      "src": "/api/ipv2/lookup/(.*)",
      "dest": "/api/ip-lookup.js?ip=$1"
    },
    {
      "src": "/api/ipv2/heat/(.*)",
      "dest": "/api/ip-v2-heat.js?ip=$1"
    },
    {
      "src": "/api/ipv2/bgp/(.*)",
      "dest": "/api/ip-v2-bgp.js?ip=$1"
    },
    {
      "src": "/api/ipv2/dnsbl/(.*)",
      "dest": "/api/ip-v2-dnsbl.js?ip=$1"
    },
    {
      "src": "/api/ipv2/asncos/(.*)",
      "dest": "/api/ip-v2-asncos.js?asn=$1"
    },
    {
      "src": "/api/ip/related/(.*)",
      "dest": "/api/ip-related.js?ip=$1"
    },
    {
      "src": "/api/ip/pingcheck/(.*)",
      "dest": "/api/ip-pingcheck.js?ip=$1"
    },
    {
      "src": "/api/ip/portscan/(.*)",
      "dest": "/api/ip-portscan.js?ip=$1"
    },
    {
      "src": "/api/ping/global",
      "dest": "/api/ping-global.js"
    },
    {
      "src": "/api/google-check/(.*)",
      "dest": "/api/google-check.js?ip=$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1.js"
    },
    {
      "src": "^/ip/(.*\\.(?:js|css|png|jpg|svg|txt|webp))$",
      "dest": "/public/ip/$1"
    },
    {
      "src": "^/ip(?:/.*)?$",
      "dest": "/public/ip/index.html"
    },
    {
      "src": "^/google/(.*\\.(?:js|css|png|jpg|svg|txt|webp))$",
      "dest": "/public/google/$1"
    },
    {
      "src": "^/(?:google|gemini)(?:/.*)?$",
      "dest": "/public/google/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
